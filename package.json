{
  "name": "ligne-hosted-preview",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log node --env-file-if-exists=.env node_modules/vinext/dist/cli.js dev",
    "build": "node scripts/privacy-audit.mjs source && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/sanitize-build-output.mjs && node scripts/privacy-audit.mjs output",
    "preview:cloudflare": "pnpm run build && vite preview",
    "deploy:cloudflare": "pnpm run build && wrangler deploy",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log node --env-file-if-exists=.env node_modules/vinext/dist/cli.js start",
    "test": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "privacy:check": "node scripts/privacy-audit.mjs all",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@reown/appkit": "1.8.23",
    "@reown/appkit-adapter-bitcoin": "1.8.23",
    "@reown/appkit-adapter-wagmi": "1.8.23",
    "@tanstack/react-query": "5.102.8",
    "@wagmi/connectors": "6.2.0",
    "@wagmi/core": "2.22.1",
    "cryptocurrency-icons": "^0.18.1",
    "drizzle-orm": "0.45.2",
    "flag-icons": "^7.5.0",
    "pino": "7.11.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "2.56.0",
    "wagmi": "2.19.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
